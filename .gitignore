# Model weights / exports
*.pt
*.pth
*.onnx
*.engine
*.torchscript
*.tflite
*.mlpackage

# Media
*.mp4
*.avi
*.mov
*.mkv

# Archives
*.zip
*.tar
*.gz
*.7z

# Data & experiment outputs (never commit)
# Everything under datasets/ is DATA except the converter scripts and their
# README. Listing directories one by one missed datasets/obstacle/, which
# STEP 6b tells you to create — a `git add .` would then have committed the
# whole obstacle detection set. Allow-listing is the safe direction.
datasets/*
!datasets/README.md
!datasets/scripts/
# Exclude contents but keep the tracked placeholder: git cannot descend into a
# fully-excluded directory, so a bare `outputs/` would make `!outputs/.gitkeep` dead.
outputs/*
runs/
wandb/
mlruns/
.optuna/
*.db
*.db-journal

# Python
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/
.coverage
htmlcov/

# Generated dataset configs: prepare_sunrgbd.py writes an absolute dataset root
# into these, so they are machine-specific and must not be committed.
configs/data/*.yaml
configs/data/*.json
!configs/data/.gitkeep

# Secrets / local env
.env
.env.*
*.pem
*.key
credentials.json
secrets.yaml

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Keep placeholders
!outputs/.gitkeep
!.gitkeep
